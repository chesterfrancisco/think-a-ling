{
  "name": "think-a-ling",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "setup:ai": "node scripts/prepare-ai-assets.mjs",
    "check:ai": "node scripts/check-ai-assets.mjs",
    "test:reasoning": "node --experimental-strip-types --test scripts/reasoning.test.mjs scripts/scene-intent.test.mjs",
    "test": "node --experimental-strip-types --test scripts/*.test.mjs",
    "prebuild": "npm run check:ai",
    "postbuild": "node scripts/check-ai-assets.mjs --dist",
    "test:production": "node scripts/validate-production.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.54.0",
    "motion": "^14.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
